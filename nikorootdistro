    choose_os
    clear
}

main_loop() {
    while true; do
        prompt
        read -r cmd args
        case "$cmd" in
            apt|dnf|slackpkg|zypper)
                sub=$(echo "$args" | awk '{print $1}')
                pkg=$(echo "$args" | cut -d' ' -f2)
                case "$sub" in
                    install|in) pkg_install "$pkg" ;;
                    remove|rm)  pkg_remove "$pkg" ;;
                    *)          echo "usage: $cmd install|remove <pkg>" ;;
                esac
                ;;
            pacman)
                flag=$(echo "$args" | awk '{print $1}')
                pkg=$(echo "$args" | cut -d' ' -f2)
                case "$flag" in
                    -S) pkg_install "$pkg" ;;
                    -R) pkg_remove "$pkg" ;;
                    *)  echo "usage: pacman -S|-R <pkg>" ;;
                esac
                ;;
            emerge) pkg_install "$(echo "$args" | awk '{print $1}')" ;;
            xbps-install)
                flag=$(echo "$args" | awk '{print $1}')
                pkg=$(echo "$args" | cut -d' ' -f2)
                case "$flag" in
                    -y) pkg_install "$pkg" ;;
                    *)  pkg_install "$flag" ;;
                esac
                ;;
            nix-env)
                flag=$(echo "$args" | awk '{print $1}')
                pkg=$(echo "$args" | cut -d' ' -f2)
                case "$flag" in
                    -i) pkg_install "$pkg" ;;
                    *)  echo "usage: nix-env -i <pkg>" ;;
                esac
                ;;
            apk)
                sub=$(echo "$args" | awk '{print $1}')
                pkg=$(echo "$args" | cut -d' ' -f2)
                case "$sub" in
                    add) pkg_install "$pkg" ;;
                    del) pkg_remove "$pkg" ;;
                    *)   echo "usage: apk add|del <pkg>" ;;
                esac
                ;;
            neofetch) show_neofetch ;;
            firefox) firefox_browser ;;
            archinstall) archinstall_run ;;
            switch)   switch_os ;;
            help)     help_show ;;
            whoami)   echo "$CURRENT_USER" ;;
            uname)
                echo "Linux $CURRENT_HOST 6.6.0-nikoroot #1 SMP x86_64 GNU/Linux"
                ;;
            cat)
                if [ "$args" = "/etc/os-release" ]; then
                    os_release
                else
                    echo "cat: $args: No such file or directory"
                fi
                ;;
            ls)       ls ;;
            pwd)      pwd ;;
            date)     date ;;
            clear)    clear ;;
            exit|quit) echo "bye"; exit 0 ;;
            "")       ;;
            *)        echo "$cmd: command not found" ;;
        esac
    done
}

while ! choose_os; do :; done
main_loop

firefox_browser() {
    while true; do
        printf "${BOLD}firefox>${RESET} "
        read -r query
        case "$query" in
            ""|exit|quit) echo "closing firefox..."; return ;;
            clear) clear ;;
            help) echo "Type search query or: exit" ;;
            *)
                echo ""
                echo "  Searching for: $query"
                sleep 0.4
                echo "  --------------------------------"
                echo "  1. $query - Wikipedia"
                echo "  2. $query - YouTube"
                echo "  3. $query - GitHub"
                echo "  4. $query - Reddit"
                echo "  --------------------------------"
                echo "  (simulated results)"
                echo ""
                ;;
        esac
    done
}


