pkg_install() {
    pkg="$1"
    if [ -z "$pkg" ]; then
        echo "error: no targets specified"
        return 1
    fi
    printf "Proceed? [Y/n] "
    read -r ans
    case "$ans" in
        n|N|no|NO) echo "Aborted."; return 1 ;;
    esac
    printf "Proceed? [Y/n] "
    read -r ans
    case "$ans" in
        n|N|no|NO) echo "Aborted."; return 1 ;;
    esac
    out=$(apk add "$pkg" 2>&1)
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "error: package '$pkg' not found"
        return 1
    fi
    case "$CURRENT_OS" in
        mint|ubuntu|debian|kali|popos|elementary|zorin|mxlinux|parrot|deepin|devuan|antix)
            echo "Reading package lists... Done"
            echo "Building dependency tree... Done"
            echo "Setting up $pkg ..."
            ;;
        fedora|centos|rocky|alma|oracle|rhel|nobara)
            echo "Dependencies resolved."
            echo "Installing : $pkg"
            echo "Complete!"
            ;;
        arch|artix|manjaro|garuda|endeavouros|cachyos|archbang|blackarch)
            echo "resolving dependencies..."
            echo "(1/1) installing $pkg"
            ;;
        slackware)
            echo "Installing package $pkg ..."
            echo "Done."
            ;;
        opensuse)
            echo "Loading repository data..."
            echo "Installing: $pkg"
            ;;
        gentoo)
            echo ">>> Emerging (1 of 1) $pkg"
            ;;
        void)
            echo "Installing $pkg ..."
            echo "Done."
            ;;
        nixos)
            echo "building '$pkg'..."
            echo "Done."
            ;;
        alpine)
            echo "(1/1) Installing $pkg"
            ;;
    esac
    echo "$out" | tail -1
}

pkg_remove() {
    pkg="$1"
    if [ -z "$pkg" ]; then
        echo "error: no targets specified"
        return 1
    fi
    out=$(apk del "$pkg" 2>&1)
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "error: package '$pkg' not installed"
        return 1
    fi
    echo "Removing $pkg ..."
    echo "$out" | tail -1
}

