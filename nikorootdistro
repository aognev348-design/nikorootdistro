}

spinfetch() {
    set_display_name
    i=0
    # получаем ASCII текущей ОС БЕЗ первой строки с инфой
    ascii=$(distro_ascii 2>/dev/null | sed 's/Alpine Linux/'"$CURRENT_DISPLAY"'/')
    while [ $i -lt 30 ]; do
        clear
        case $((i % 4)) in
            0) echo "         ◢   ◣" ;;
            1) echo "         ◤   ◥" ;;
            2) echo "         ◥   ◤" ;;
            3) echo "         ◣   ◢" ;;
        esac
        echo ""
        echo "$ascii"
        echo ""
        i=$((i + 1))
        sleep 0.2
    done
    clear
}

rnd_sleep() {
    n=$((RANDOM % 8 + 2))
    sleep 0.$n
}

maybe_freeze() {
    r=$((RANDOM % 100))
    if [ $r -lt 15 ]; then
        printf "[ .... ] A start job is running for Wait for Network ("
        printf "%ds / 1min 30s)" $((RANDOM % 10 + 3))
        sleep $((RANDOM % 3 + 2))
        printf "\r${GREEN}[  OK  ]${RESET} Finished Wait for Network.\n"
    fi
}

